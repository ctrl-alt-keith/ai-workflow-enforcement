# Template only. Replace every __CODEX_SAFE_RM_ABSOLUTE_PATH__ token with the
# exact resolved absolute path verified by the Playbook installer before this
# rule is activated. An unresolved token is not a valid active rule.
#
# Direct rm remains prompt-gated. Dynamic operand validation is delegated to
# the Playbook-managed helper because prefix_rule cannot validate suffixes.
prefix_rule(
    pattern=["rm"],
    decision="prompt",
    justification="Direct filesystem deletion requires explicit approval.",
    match=[
        "rm -rf -- build",
        "rm -rf -- /tmp/foo",
    ],
    not_match=[
        "__CODEX_SAFE_RM_ABSOLUTE_PATH__ -rf -- build",
    ],
)

prefix_rule(
    pattern=["__CODEX_SAFE_RM_ABSOLUTE_PATH__", "-rf", "--"],
    decision="allow",
    justification="The Playbook-managed helper validates every operand and enforces safe containment beneath the invocation cwd.",
    match=[
        "__CODEX_SAFE_RM_ABSOLUTE_PATH__ -rf -- pytest-of-root",
        "__CODEX_SAFE_RM_ABSOLUTE_PATH__ -rf -- .pytest_cache",
        "__CODEX_SAFE_RM_ABSOLUTE_PATH__ -rf -- build dist",
        "__CODEX_SAFE_RM_ABSOLUTE_PATH__ -rf -- docs/_build",
        "__CODEX_SAFE_RM_ABSOLUTE_PATH__ -rf -- knowledge-adapters",
    ],
    not_match=[
        "rm -rf -- build",
        "__CODEX_SAFE_RM_ABSOLUTE_PATH__ -r -- build",
        "__CODEX_SAFE_RM_ABSOLUTE_PATH__ -- build",
    ],
)
