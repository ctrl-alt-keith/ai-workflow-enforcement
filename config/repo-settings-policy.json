{
  "schema_version": 1,
  "baseline": {
    "visibility": "public",
    "default_branch": "main",
    "require_pull_requests": true,
    "require_status_checks": true,
    "strict_required_checks": false,
    "force_pushes": "disabled",
    "branch_deletions": "disabled",
    "merge_policy": "squash-only",
    "auto_merge": "disabled",
    "delete_branch_on_merge": "enabled",
    "required_approving_reviews": 0,
    "administrator_bypass": "enabled",
    "dependabot": {
      "enabled": "auto",
      "ecosystems": [
        "github-actions",
        "pip"
      ],
      "schedule": "weekly"
    }
  },
  "repositories": {
    "ctrl-alt-keith/ai-workflow-incubator": {
      "visibility": "private",
      "auto_merge": "enabled",
      "required_checks": [
        "markdownlint"
      ]
    },
    "ctrl-alt-keith/leadership-workbench": {
      "visibility": "private",
      "require_status_checks": false,
      "administrator_bypass": "disabled",
      "dependabot": {
        "enabled": false
      }
    },
    "ctrl-alt-keith/knowledge-vault": {
      "visibility": "private"
    },
    "ctrl-alt-keith/lke-image-lab": {
      "visibility": "private"
    },
    "ctrl-alt-keith/nexus": {
      "visibility": "private",
      "required_checks": [
        "check"
      ]
    },
    "ctrl-alt-keith/.github": {
      "required_checks": [
        "markdownlint"
      ]
    },
    "ctrl-alt-keith/ai-workflow-playbook": {
      "required_checks": [
        "markdownlint"
      ]
    },
    "ctrl-alt-keith/linode-backup-lab": {
      "required_checks": [
        "authoritative-source-check / authoritative-source-check",
        "make check"
      ]
    },
    "ctrl-alt-keith/linode-image-lab": {
      "required_checks": [
        "make check"
      ]
    },
    "ctrl-alt-keith/knowledge-adapters": {
      "required_checks": [
        "test"
      ]
    },
    "ctrl-alt-keith/ka-destinations": {
      "required_checks": [
        "check"
      ]
    },
    "ctrl-alt-keith/trusted-network-registry": {
      "required_checks": [
        "authoritative-source-check / authoritative-source-check",
        "make check"
      ]
    },
    "ctrl-alt-keith/trusted-ai-environment": {
      "required_checks": [
        "make check"
      ]
    }
  }
}
