{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ctrl-alt-keith/ai-workflow-enforcement/schemas/hosted-stewardship-receipt.schema.json",
  "title": "Hosted Stewardship Engine receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_identifier",
    "started_at",
    "completed_at",
    "mode",
    "repository",
    "base_branch",
    "base_sha",
    "engine_revision",
    "strategy_identifier",
    "strategy_revision",
    "eligibility",
    "strategy_result",
    "changed_paths",
    "diff_digest",
    "patch_artifact",
    "validation",
    "proposed_branch",
    "proposed_commit_message",
    "proposed_pr_title",
    "proposed_pr_body",
    "collision",
    "would_create_pr",
    "would_create_pr_reason",
    "remote_mutations_attempted",
    "remote_mutation_results",
    "final_terminal_state",
    "failure_stage",
    "bounded_error",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_identifier": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": ["string", "null"]},
    "mode": {"enum": ["dry-run", "propose"]},
    "repository": {"type": "string", "minLength": 1},
    "base_branch": {"type": ["string", "null"]},
    "base_sha": {"type": ["string", "null"]},
    "engine_revision": {"type": "string", "minLength": 1},
    "strategy_identifier": {"const": "docs-drift"},
    "strategy_revision": {"const": "1"},
    "eligibility": {"type": "object"},
    "strategy_result": {"type": "object"},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "diff_digest": {"type": ["string", "null"]},
    "patch_artifact": {"type": ["string", "null"]},
    "validation": {"type": "object"},
    "proposed_branch": {"type": ["string", "null"]},
    "proposed_commit_message": {"type": ["string", "null"]},
    "proposed_pr_title": {"type": ["string", "null"]},
    "proposed_pr_body": {"type": ["string", "null"]},
    "collision": {"type": "object"},
    "would_create_pr": {"type": "boolean"},
    "would_create_pr_reason": {"type": "string"},
    "remote_mutations_attempted": {"type": "array", "items": {"type": "string"}},
    "remote_mutation_results": {"type": "array", "items": {"type": "object"}},
    "final_terminal_state": {"type": "string", "minLength": 1},
    "failure_stage": {"type": ["string", "null"]},
    "bounded_error": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"type": "string"}}
  }
}
